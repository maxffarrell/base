# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Public demo mode: risky features disabled.
BASE_DEMO=

# Base Cloud / enterprise features (SSO, passkeys).
BASE_CLOUD=
BASE_ENTERPRISE_KEY=

# Email (optional). Without a provider, emails are only written to the server log.
EMAIL_FROM=
RESEND_API_KEY=
SMTP_URL=

# Protects /api/cron.
CRON_SECRET=

# AI features (Enterprise). Any OpenAI-compatible endpoint or Anthropic;
# the key stays server-side. No provider ships with Base.
AI_PROVIDER=   # openai | anthropic
AI_API_KEY=
AI_MODEL=
AI_BASE_URL= # optional, e.g. http://localhost:11434/v1 for Ollama

# Social sign-in (each provider shows up once its keys are set). Redirect URIs:
# <ORIGIN>/api/auth/callback/google and /github.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
